# Copy this file to ".env" and change the values. Never commit ".env".

# Signs login tokens - use a long random string (at least 32 characters)
SECRET_KEY=put-a-long-random-string-here

# PostgreSQL (the "db" service in docker-compose.yml)
POSTGRES_USER=po_tracker
POSTGRES_PASSWORD=po_tracker
POSTGRES_DB=po_tracker

# Password given to every demo account created by seed.py
SEED_PASSWORD=Password123!

# Attachments
MAX_UPLOAD_MB=10

# Shown on the frontend; dates are stored in UTC
APP_TIMEZONE=Asia/Kuala_Lumpur
